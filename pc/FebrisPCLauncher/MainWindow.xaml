<Window x:Class="Febris.PCLauncherV3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Febris.PCLauncherV3"
        xmlns:view="clr-namespace:Febris.PCLauncherV3.MVVM.View"
        xmlns:vm="clr-namespace:Febris.PCLauncherV3.MVVM.ViewModel"
        mc:Ignorable="d"   
        WindowStyle="None"
        Height="500" 
        Width="800"         
        Background="Transparent"
        AllowsTransparency="True"    
        >
    <!--Loaded="MainWindowLoaded"-->
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>


    <!--<Border Background="{StaticResource ResourceKey=PrimaryBackgroundColor}"#2A3F54\-->
    <Border Background="{DynamicResource PrimaryBackgroundColor}"
            CornerRadius="20" MouseLeftButtonDown="Window_MouseDown">
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!--Formatting-->
            <Grid.RowDefinitions>
                <!--<RowDefinition Height="28" />-->
                <!--<RowDefinition Height="28" MinHeight="28" />-->
                <!--<RowDefinition Height="12.04" />-->
                <RowDefinition Height="75"/>
                <RowDefinition Height="425" />
                <!--MinHeight="28"/>-->
                <!--<RowDefinition Height="*" MinHeight="80"/>
                <RowDefinition Height="Auto" MinHeight="28" />
                <RowDefinition Height="*" MinHeight="80" />
                <RowDefinition Height="28" />-->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <!--<ColumnDefinition Width="3*" MinWidth="200" />-->
                <!--<ColumnDefinition/>-->
                <!--<ColumnDefinition Width="4*" MinWidth="300" />-->
                <ColumnDefinition Width="600" />
            </Grid.ColumnDefinitions>

            <!--Top Bar-->
            <StackPanel 
                Grid.Column="1"
                Grid.Row="0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <!--MouseLeftButtonDown="Window_MouseDown"
                >-->
                <Button 
                        Background="Transparent"
                        Foreground="{DynamicResource LightTextColor}"
                        Margin="10"
                        Click="RefreshInformation"
                        BorderBrush="Transparent"
                    Content="Reload"
                    VerticalAlignment="Top"
                        >

                    <!--<TextBlock 
                        Text="&#xf01e;" 
                        FontFamily="{StaticResource FontAwesome}"
                        />-->
                    <!--<TextBlock Text="{StaticResource RefreshIcon}"/>-->
                    <!--<Button.Content>
                        <TextBlock Style="{StaticResource ResourceKey=RefreshIcon}"/>
                    </Button.Content>-->
                </Button>
                <Button 
                        Background="Transparent"
                        Foreground="{DynamicResource LightTextColor}"
                        Margin="10"
                        Click="CloseWindow"
                        BorderBrush="Transparent"
                    Content="X"
                    FontWeight="Bold"
                    VerticalAlignment="Top"
                    FontSize="15"
                        >

                    <!--<TextBlock 
                        Text="&#xf01e;" 
                        FontFamily="{StaticResource FontAwesome}"
                        />-->

                </Button>
            </StackPanel>
            <!--Sidebar-->
            <Image Grid.Column="0" 
                   Grid.Row="0"
                   VerticalAlignment="Top"                   
                   Source="Images/FebrisLogo_White.png" 
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <StackPanel Grid.Row="2" 
                 Grid.RowSpan="6">
                <RadioButton
                    Content="Home"                    
                    Style="{StaticResource RadioMenuTheme}"
                    IsChecked="True"
                    Command="{Binding HomeViewCommand}"
                    />
                <RadioButton
                    Content="Users"                    
                    Style="{StaticResource RadioMenuTheme}"
                    Command="{Binding UserViewCommand}"
                    />
                <RadioButton
                    Content="Modules"                   
                    Style="{StaticResource RadioMenuTheme}"
                    Command="{Binding ModuleViewCommand}"
                    />
                <RadioButton
                    Content="Launch"                   
                    Style="{StaticResource RadioMenuTheme}"
                    Command="{Binding LaunchViewCommand}"
                    />
                <RadioButton
                    Content="Config"                   
                    Style="{StaticResource RadioMenuTheme}"
                    Command="{Binding ConfigViewCommand}"
                    />                
                <RadioButton
                    Content="Statement Files"                   
                    Style="{StaticResource RadioMenuTheme}"
                    Command="{Binding StatementViewCommand}"
                    />
                <RadioButton
                    Content="Video Files"                   
                    Style="{StaticResource RadioMenuTheme}"
                    Command="{Binding VideoViewCommand}"
                    />

            </StackPanel>

            <!--Content Control for actual Data-->
            <ContentControl
                Grid.Row="1"                
                Grid.Column="1"
                Content="{Binding CurrentView}"/>


        </Grid>
    </Border>
</Window>




