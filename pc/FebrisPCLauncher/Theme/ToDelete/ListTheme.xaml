                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Name="Message" Text="{Binding Path=Message}" Background="{x:Null}" Foreground="White" HorizontalAlignment="Center" TextWrapping="Wrap"></TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>

                                <TextBlock IsHitTestVisible="False"
                                       Text="Search"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       Margin="10,0,0,0"
                                       FontSize="11"
                                       Foreground="{StaticResource FilledBoxBackgroundColor}"                                                                              
                                       >
