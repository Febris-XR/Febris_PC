<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Febris-icon.ico</ApplicationIcon>
    <SignAssembly>false</SignAssembly>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Images\DefaultMedia\DefaultPerson.png" />
    <None Remove="Images\DefaultPerson.png" />
    <None Remove="Images\FebrisLogo_White.png" />
    <None Remove="Resources\Icons\fa-brands-400.ttf" />
    <None Remove="Resources\Icons\fa-regular-400.ttf" />
    <None Remove="Resources\Icons\fa-solid-900.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.1" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Febris.EnumLibrary" Version="0.1.1" />
    <PackageReference Include="Febris.ModelLibrary" Version="0.1.1" />
    <PackageReference Include="Febris.SharedServices" Version="0.1.1" />
    <ProjectReference Include="..\FebrisPCModuleManager\Febris.PCModuleManagerV3.csproj" />
    <ProjectReference Include="..\FebrisPCProgressBar\Febris.ConsoleProgressBar.csproj" />
    <ProjectReference Include="..\FebrisPCScreenRecorder\Febris.PCScreenRecorderV3.csproj" />
    <ProjectReference Include="..\FebrisPCStatementManager\Febris.PCStatementManagerV3.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Images\DefaultMedia\DefaultPerson.png" />
    <Resource Include="Images\DefaultPerson.png" />
    <Resource Include="Images\FebrisLogo_White.png" />
    <Resource Include="Resources\Icons\fa-brands-400.ttf" />
    <Resource Include="Resources\Icons\fa-regular-400.ttf" />
    <Resource Include="Resources\Icons\fa-solid-900.ttf" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Page Update="Theme\BodyTextTheme.xaml">
      <XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Theme\PasswordInputboxTheme.xaml">
      <XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Theme\MessageboardTheme.xaml">
      <XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Theme\InputboxTheme.xaml">
      <XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Theme\ToDelete\ToggleSwitchTheme.xaml">
      <XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

</Project>
