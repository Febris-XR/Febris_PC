<UserControl x:Class="Febris.PCLauncherV3.MVVM.View.VideoView"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Febris.PCLauncherV3.MVVM.View"
             xmlns:viewModel="clr-namespace:Febris.PCLauncherV3.MVVM.ViewModel"
             mc:Ignorable="d" 
             Margin="0"             
             d:DesignWidth="600"
             d:DesignHeight="425"
             Background="Transparent">
    <!--d:DesignHeight="Auto"-->
    <!--<UserControl.DataContext>
        <viewModel:MainViewModel/>
    </UserControl.DataContext>-->

    <Border Background="{StaticResource ResourceKey=SecondaryBackgroundColor}"
            CornerRadius="0,0,20,0">

        <StackPanel MaxHeight="415">
            
            
            <Label
                Content="Unsent Video Files"
                Style="{StaticResource ResourceKey=TitleTheme}"/>
            <StackPanel 
                HorizontalAlignment="Center"
                Orientation="Horizontal">              
                <Border Width="400">
                    <Grid>
                        <StackPanel>
                            <ListBox                                
                                ItemsSource="{Binding Path=UnsentVideoFileList}"
                                ScrollViewer.VerticalScrollBarVisibility="Visible"
                                ScrollViewer.CanContentScroll="True"
                                BorderBrush="Transparent"
                                Height="150">                                
                                <ListBox.ItemTemplate >
                                    <DataTemplate >
                                        <StackPanel 
                                            Orientation="Vertical"  
                                            Margin="0,0,0,15" 
                                            VerticalAlignment="Center">
                                            <TextBlock 
                                                Text="{Binding}"
                                                Background="Transparent" 
                                                Foreground="{DynamicResource SecondaryTextColor}" 
                                                HorizontalAlignment="Left" 
                                                TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <Label
                Content="Sent Recordings"
                Style="{StaticResource ResourceKey=TitleTheme}"/>
            <StackPanel 
                Orientation="Horizontal"                
                HorizontalAlignment="Center">
                
                <Border Width="400">                   
                    <Grid>
                        <StackPanel>
                            <ListBox 
                                ItemsSource="{Binding Path=SentVideoFileList}"
                                ScrollViewer.VerticalScrollBarVisibility="Visible"
                                ScrollViewer.CanContentScroll="True"
                                BorderBrush="Transparent"
                                Height="150">                               
                                <ListBox.ItemTemplate >
                                    <DataTemplate >
                                        <StackPanel Orientation="Vertical"  
                                                    Margin="0,0,0,15" 
                                                    VerticalAlignment="Center">                                           
                                            <TextBlock     
                                                Text="{Binding}"
                                                Background="Transparent" 
                                                Foreground="{DynamicResource SecondaryTextColor}" 
                                                HorizontalAlignment="Left" 
                                                TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>

    </Border>
</UserControl>
