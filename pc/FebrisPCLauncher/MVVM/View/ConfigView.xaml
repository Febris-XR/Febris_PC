<UserControl x:Class="Febris.PCLauncherV3.MVVM.View.ConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Febris.PCLauncherV3.MVVM.View"                 
             xmlns:vm="clr-namespace:Febris.PCLauncherV3.MVVM.ViewModel"              
             mc:Ignorable="d" 
             Margin="0"  
             d:DesignWidth="600"
             d:DesignHeight="425"
             Background="Transparent"             
             >
    <!--<UserControl.DataContext>
        <viewModel:MainViewModel/>
    </UserControl.DataContext>-->

    <Border Background="{StaticResource ResourceKey=SecondaryBackgroundColor}"              
            CornerRadius="0,0,20,0">

        <StackPanel>
            <Label
                Content="Configuration Menu"
                Style="{StaticResource ResourceKey=TitleTheme}"/>
            <StackPanel Margin="20">


                <StackPanel Orientation="Horizontal">
                    <Label Content="Hardware License: " 
                       Style="{StaticResource ResourceKey=BodyTextTheme}"
                       FontWeight="Bold"/>
                    <!--<Label Name="HardwareLicense"
                       Style="{StaticResource ResourceKey=BodyTextTheme}"
                       Content="{Binding ConfigVM.HardwareLicense}"/>-->
                    <TextBox 
                        Name="HardwareLicense"
                        Style="{StaticResource ResourceKey=InputBoxTheme}"
                        Text="{Binding Path=HardwareLicense}"/>

                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Label Content="Developer Account " 
                       Style="{StaticResource ResourceKey=BodyTextTheme}"
                       FontWeight="Bold"/>
                    <CheckBox Name="DeveloperAccount"  
                              VerticalAlignment="Center"
                              IsChecked="{Binding Path=ConfigModel.DeveloperAccount, Mode=TwoWay}"
                              IsEnabled="True"
                              />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding Path=DeveloperAccountSelected}">
                    <Label Content="Domain Prefix: "                        
                       FontWeight="Bold"
                       Style="{StaticResource ResourceKey=BodyTextTheme}"/>
                    <TextBox 
                        Name="DomainPrefixInput"                                                      
                        Text="{Binding Path=ConfigModel.DomainPrefix,
                        UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource ResourceKey=InputBoxTheme}"
                        >
                    </TextBox>
                    <!--Style="{StaticResource ResourceKey=InputBoxTheme}"-->
                </StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding Path=DeveloperAccountSelected}">
                    <Label Content="Domain: "                        
                       FontWeight="Bold"
                       Style="{StaticResource ResourceKey=BodyTextTheme}"/>
                    <TextBox 
                        Name="DomainInput"                                                      
                        Text="{Binding Path=ConfigModel.Domain,
                        UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource ResourceKey=InputBoxTheme}"
                        >
                    </TextBox>
                    <!--Style="{StaticResource ResourceKey=InputBoxTheme}"-->
                </StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding Path=DeveloperAccountSelected}">
                    <Label Content="Domain Port: "                        
                       FontWeight="Bold"
                       Style="{StaticResource ResourceKey=BodyTextTheme}"/>
                    <TextBox 
                        Name="DomainPortInput"                                                      
                        Text="{Binding Path=ConfigModel.DomainPort,
                        UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource ResourceKey=InputBoxTheme}"
                        >
                    </TextBox>
                    <!--Style="{StaticResource ResourceKey=InputBoxTheme}"-->
                </StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding Path=DeveloperAccountSelected}">
                    <Label Content="Domain Path: "                        
                       FontWeight="Bold"
                       Style="{StaticResource ResourceKey=BodyTextTheme}"/>
                    <TextBox 
                        Name="DomainPathInput"                                                      
                        Text="{Binding Path=ConfigModel.DomainPath,
                        UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource ResourceKey=InputBoxTheme}"
                        >
                    </TextBox>
                    <!--Style="{StaticResource ResourceKey=InputBoxTheme}"-->
                </StackPanel>


                <!--Command="{Binding StatementVMCommand, 
                        RelativeSource={RelativeSource AncestorType=Window}}"-->
                <StackPanel Orientation="Horizontal">

                    <Button
                    Margin="20"
                    Height="25"
                    Width="100"
                    Background="{DynamicResource PrimaryButtonColor}"
                    Foreground="{DynamicResource LightTextColor}"
                    FontWeight="Bold"                    
                    Content="Save Settings"
                    Command="{Binding Path=SaveDomainCommand}">
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button
                    Margin="20"
                    Height="25"
                    Width="100"
                    Background="{DynamicResource PrimaryButtonColor}"
                    Foreground="{DynamicResource LightTextColor}"
                    FontWeight="Bold"                    
                    Content="Restart Services"
                    Click="ServiceRestartCommand_Click"
                    >
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button
                    Margin="20"
                    Height="25"
                    Width="100"
                    Background="{DynamicResource PrimaryButtonColor}"
                    Foreground="{DynamicResource LightTextColor}"
                    FontWeight="Bold"                    
                    Content="Open Portal"
                    Click="OpenPortal_Click"
                    >
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                </StackPanel>


                <!--This adds the optional Sign in-->
                <StackPanel Orientation="Horizontal">
                    <Label
                Content="User sign in (optional)"
                Style="{StaticResource ResourceKey=BodyTextTheme}"/>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="Credentials Exist In System " 
                       Style="{StaticResource ResourceKey=BodyTextTheme}"
                       FontWeight="Bold"/>
                        <CheckBox Name="UserSelected"  
                              VerticalAlignment="Center"
                              IsChecked="{Binding Path=CredentialsExist}"
                              IsEnabled="False"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal">
                    <Label Content="Email Address:" 
                       Style="{StaticResource ResourceKey=BodyTextTheme}"
                       FontWeight="Bold"/>
                    <TextBox Name="EmailAddress"
                           Style="{StaticResource ResourceKey=InputBoxTheme}"
                           Text="{Binding Path=EmailAddress}"/>
                </StackPanel>


                <StackPanel Orientation="Horizontal">
                    <Label Content="Password" 
                       Style="{StaticResource ResourceKey=BodyTextTheme}"
                       FontWeight="Bold"/>
                    <PasswordBox Name="PasswordInput"
                                Style="{StaticResource ResourceKey=PasswordInputBoxTheme}"
                                />
                </StackPanel>
                </StackPanel>                
                <Button
                    HorizontalAlignment="Left"
                    Margin="20"
                    Height="25"
                    Width="100"
                    Background="{DynamicResource PrimaryButtonColor}"
                    Foreground="{DynamicResource LightTextColor}"
                    FontWeight="Bold"                    
                    Content="Save"
                    Click="SaveCredentials_Click">
                    <!--Command="{Binding SignInCommand}"
                    >-->
                    <Button.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>
                
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>


