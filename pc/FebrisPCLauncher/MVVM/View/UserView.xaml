<UserControl x:Class="Febris.PCLauncherV3.MVVM.View.UserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Febris.PCLauncherV3.MVVM.View"
             xmlns:viewModel="clr-namespace:Febris.PCLauncherV3.MVVM.ViewModel"
             mc:Ignorable="d" 
             Margin="0"             
             d:DesignWidth="600"
             d:DesignHeight="425"             
             Background="Transparent">
    <!--d:DesignHeight="Auto"-->
    <!--<UserControl.DataContext>
        <viewModel:MainViewModel/>
    </UserControl.DataContext>-->

    <Border Background="{StaticResource ResourceKey=SecondaryBackgroundColor}" 
            CornerRadius="0,0,20,0">

        <StackPanel Orientation="Horizontal">
            <StackPanel>
                
                <StackPanel Orientation="Horizontal">
                    <Label
                        Content="User List"
                        Style="{StaticResource ResourceKey=TitleTheme}"/>
                    
                    <!--<Border CornerRadius="10"
                            Background="{DynamicResource FilledBoxBackgroundColor}"
                            Margin="2">
                        <Grid>
                            <Rectangle StrokeThickness="1"/>                        
                            <TextBox 
                             Width="150"
                             Margin="5"
                             Name="UserSearch" 
                             Text="{Binding Path=UserSearch,
                             UpdateSourceTrigger=PropertyChanged}"                                      
                                     BorderThickness="0"
                                     Background="Transparent"
                                     VerticalAlignment="Center"
                                     Padding="2"
                                     Foreground="{DynamicResource PrimaryTextColor}"                                     
                        />
                        </Grid>
                    </Border>-->
                    <TextBox 
                            Width="150"
                            Margin="5"
                            Name="UserSearch" 
                            Text="{Binding Path=UserSearch,
                            UpdateSourceTrigger=PropertyChanged}" 
                            Style="{StaticResource ResourceKey=SearchBoxTheme}"                                                                          
                        />
                    <!--Style="{StaticResource ResourceKey=SearchBoxTheme}"
                             />-->
                    <!--Text="{Binding Path=UserSearch,ElementName=UserSelectBox, Mode=OneWay}"/>-->
                    <!--TextChanged="UserSearchFilter_TextChanged"/>--> <!--TextChanged="UserSearchFilter_TextChanged"/>-->
                    <!--Text="{Binding Path=UserSearch}"-->
                             
                </StackPanel>               
                
                <StackPanel MaxHeight="300">
                    <ListBox ItemsSource="{Binding Path=SearchResultList}"
                             Style="{StaticResource ResourceKey=ModuleListTheme}" 
                             SelectedItem="{Binding Path=DisplayedUser}"
                             Name="UserSelectBox"
                             ScrollViewer.VerticalScrollBarVisibility="Visible"
                             ScrollViewer.CanContentScroll="True"
                             Height="275">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <!--<TextBlock Text="{Binding IdentificationNumber, Mode=OneWay}"/>-->
                                    <TextBlock Text=" "/>
                                    <TextBlock Text="{Binding FirstName, Mode=OneWay}"/>
                                    <TextBlock Text=" "/>
                                    <TextBlock Text="{Binding LastName, Mode=OneWay}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </StackPanel>
            <StackPanel MaxWidth="350">
                <Image Source="/Images/DefaultPerson.png" Width="100"/>
                <StackPanel Orientation="Horizontal">
                    <Label Content="First Name:" 
                       Style="{StaticResource ResourceKey=BodyTextTheme}"
                       FontWeight="Bold"/>
                    <Label Name="FirstName"
                           Style="{StaticResource ResourceKey=BodyTextTheme}"
                           Content="{Binding Path=DisplayedUser.FirstName}"/>                    
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Label Content="Last Name:" 
                       Style="{StaticResource ResourceKey=BodyTextTheme}"
                       FontWeight="Bold"/>
                    <Label Name="LastName"
                           Style="{StaticResource ResourceKey=BodyTextTheme}"
                           Content="{Binding Path=DisplayedUser.LastName}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Label Content="Id: " 
                       Style="{StaticResource ResourceKey=BodyTextTheme}"
                       FontWeight="Bold"/>
                    <Label Name="IdentificationNumber"
                           Style="{StaticResource ResourceKey=BodyTextTheme}"
                           Content="{Binding Path=DisplayedUser.IdentificationNumber}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Label Content="Email Address:" 
                       Style="{StaticResource ResourceKey=BodyTextTheme}"
                       FontWeight="Bold"/>
                    <Label Name="EmailAddress"                           
                           Style="{StaticResource ResourceKey=BodyTextTheme}"
                           Content="{Binding Path=DisplayedUser.EmailAddress}"/>
                </StackPanel>

               
                <Button
                    Margin="50"
                    Height="25"
                    Width="100"
                    Background="{DynamicResource PrimaryButtonColor}"
                    Foreground="{DynamicResource LightTextColor}"
                    FontWeight="Bold"                    
                    Content="Select User"
                    Command="{Binding Path=SelectUserCommand}"                                       
                    >
                    <!--Click="SelectUser_Click"-->
                    <!--Command="{Binding SelectUser}"-->
                    <Button.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <StackPanel Orientation="Horizontal">
                    <Label Content="Selected User:" 
                       Style="{StaticResource ResourceKey=BodyTextTheme}"
                       FontWeight="Bold"/>
                    <Label Name="SelectedUserFirstName"                           
                           Style="{StaticResource ResourceKey=BodyTextTheme}"
                           Content="{Binding Path=SelectedUser.FirstName}"/>
                </StackPanel>
                
            </StackPanel>

        </StackPanel>

    </Border>
</UserControl>
