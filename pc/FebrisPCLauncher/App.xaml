<Application x:Class="Febris.PCLauncherV3.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Febris.PCLauncherV3"
             xmlns:viewModel="clr-namespace:Febris.PCLauncherV3.MVVM.ViewModel"
             xmlns:view="clr-namespace:Febris.PCLauncherV3.MVVM.View"
             >

    <!--StartupUri="MainWindow.xaml">-->
    <Application.Resources>        
