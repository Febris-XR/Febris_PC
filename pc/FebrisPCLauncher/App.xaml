                <ResourceDictionary Source="Theme/ScrollTheme.xaml"/>
                <!--Lists-->
                <ResourceDictionary Source="Theme/MessageboardTheme.xaml"/>
                <ResourceDictionary Source="Theme/UserListTheme.xaml"/>
                <ResourceDictionary Source="Theme/ModuleListTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

