            <!--defining some colors to use in our template and style section-->
            <SolidColorBrush x:Key="PrimaryButtonColor">#26B99A</SolidColorBrush>
            <SolidColorBrush x:Key="PrimaryBackgroundColor">#2A3F54</SolidColorBrush>
            <SolidColorBrush x:Key="SecondaryBackgroundColor">#F7F7F7</SolidColorBrush>
            <SolidColorBrush x:Key="BoxBackgroundColor">#fff</SolidColorBrush>
            <SolidColorBrush x:Key="FilledBoxBackgroundColor">#D3D3D3</SolidColorBrush>
            <!--<SolidColorBrush x:Key="FilledBoxBackgroundColor">#6c757d</SolidColorBrush>-->
            <!--TextColors-->
            <SolidColorBrush x:Key="PrimaryTextColor">#5A738E</SolidColorBrush>
            <SolidColorBrush x:Key="SecondaryTextColor">#73879C</SolidColorBrush>
            <SolidColorBrush x:Key="LightTextColor">#f8f9fa</SolidColorBrush>

            <DataTemplate DataType="{x:Type viewModel:ConfigViewModel}">
                <view:ConfigView/>                
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModel:HomeViewModel}">
                <view:HomeView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModel:LaunchViewModel}">
                <view:LaunchView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModel:ModuleViewModel}">
                <view:ModuleView/>
            </DataTemplate>            
            <DataTemplate DataType="{x:Type viewModel:StatementViewModel}">
                <view:StatementView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModel:UserViewModel}">
                <view:UserView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModel:VideoViewModel}">
                <view:VideoView/>
            </DataTemplate>



