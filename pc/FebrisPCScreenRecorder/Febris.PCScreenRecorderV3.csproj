<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ApplicationIcon>Febris-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="5.0.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Febris.SharedServices" Version="0.1.1" />
    <PackageReference Include="Febris.EnumLibrary" Version="0.1.1" />
  </ItemGroup>

  <!--
    ffmpeg is a hard runtime prerequisite of the encoder, so an installed launcher must ship its
    own copy. Drop the binary in pc/tools/ffmpeg/ and it is copied beside the executable, where
    ResolveFfmpegPath looks first. Populate that folder with pc/tools/fetch-ffmpeg.ps1.

    The binary is deliberately NOT committed (pc/tools/ffmpeg/ is gitignored). It is fetched at
    build or release time, never at runtime, because air-gapped deployments are in scope.
    The build stays green without it, the recorder then reports the missing prerequisite instead.
  -->
  <ItemGroup>
    <None Include="..\tools\ffmpeg\**\*" Condition="Exists('..\tools\ffmpeg')">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
